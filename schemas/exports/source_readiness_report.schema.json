{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/osna/exports/source-readiness-report/v1",
  "title": "OSNA mapped source-readiness report",
  "type": "object",
  "required": [
    "report_version",
    "mode",
    "privacy_boundary",
    "mapping_version",
    "mapping_filename",
    "mapping_sha256",
    "data_classification",
    "quality_status",
    "input_record_count",
    "accepted_source_record_count",
    "source_validation_rejected_record_count",
    "validation_finding_count",
    "exception_count",
    "exception_counts_by_severity",
    "exception_counts_by_code",
    "source_counts"
  ],
  "properties": {
    "report_version": {"const": "1.0.0"},
    "mode": {"const": "validate_only"},
    "privacy_boundary": {
      "type": "object",
      "required": [
        "contains_row_identifiers",
        "contains_source_values",
        "counts_are_suppressed"
      ],
      "properties": {
        "contains_row_identifiers": {"const": false},
        "contains_source_values": {"const": false},
        "counts_are_suppressed": {"const": false}
      },
      "additionalProperties": false
    },
    "mapping_version": {"const": "1.0.0"},
    "mapping_filename": {
      "type": "string",
      "pattern": "^$|^[^/\\\\]+\\.json$"
    },
    "mapping_sha256": {
      "type": "string",
      "pattern": "^$|^[a-f0-9]{64}$"
    },
    "data_classification": {
      "enum": ["synthetic", "governed_clinical"]
    },
    "quality_status": {
      "enum": ["clean", "warnings_detected", "errors_detected"]
    },
    "input_record_count": {"type": "integer", "minimum": 0},
    "accepted_source_record_count": {"type": "integer", "minimum": 0},
    "source_validation_rejected_record_count": {
      "type": "integer",
      "minimum": 0
    },
    "validation_finding_count": {"type": "integer", "minimum": 0},
    "exception_count": {"type": "integer", "minimum": 0},
    "exception_counts_by_severity": {
      "type": "object",
      "properties": {
        "error": {"type": "integer", "minimum": 1},
        "warning": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "exception_counts_by_code": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "source_counts": {
      "type": "object",
      "required": [
        "theatre",
        "laboratory",
        "osna_analyser",
        "communication"
      ],
      "properties": {
        "theatre": {"$ref": "#/$defs/sourceReadiness"},
        "laboratory": {"$ref": "#/$defs/sourceReadiness"},
        "osna_analyser": {"$ref": "#/$defs/sourceReadiness"},
        "communication": {"$ref": "#/$defs/sourceReadiness"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sourceReadiness": {
      "type": "object",
      "required": [
        "filename",
        "record_count",
        "accepted_record_count",
        "rejected_record_count",
        "validation_finding_count",
        "field_readiness"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.[cC][sS][vV]$"
        },
        "record_count": {"type": "integer", "minimum": 0},
        "accepted_record_count": {"type": "integer", "minimum": 0},
        "rejected_record_count": {"type": "integer", "minimum": 0},
        "validation_finding_count": {"type": "integer", "minimum": 0},
        "field_readiness": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/fieldReadiness"
          }
        }
      },
      "additionalProperties": false
    },
    "fieldReadiness": {
      "type": "object",
      "required": [
        "source_column",
        "requirement",
        "record_count",
        "populated_value_count",
        "missing_value_count",
        "finding_counts"
      ],
      "properties": {
        "source_column": {"type": "string", "minLength": 1},
        "requirement": {"enum": ["required", "conditional"]},
        "record_count": {"type": "integer", "minimum": 0},
        "populated_value_count": {"type": "integer", "minimum": 0},
        "missing_value_count": {"type": "integer", "minimum": 0},
        "finding_counts": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "REQUIRED_VALUE_MISSING",
              "CONDITIONAL_VALUE_MISSING",
              "INVALID_POSITIVE_INTEGER",
              "INITIAL_RUN_REPEAT_METADATA",
              "INVALID_TIMESTAMP",
              "TIMEZONE_OFFSET_MISSING",
              "UNSUPPORTED_CONTROLLED_VALUE",
              "DUPLICATE_SOURCE_RECORD_ID"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"mapping_filename": {"const": ""}},
        "required": ["mapping_filename"]
      },
      "then": {
        "properties": {"mapping_sha256": {"const": ""}}
      },
      "else": {
        "properties": {
          "mapping_sha256": {"pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  ],
  "additionalProperties": false
}
